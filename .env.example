# GitHub Private Repository Configuration for Manga Data & Updates
# GITHUB_TOKEN: Personal Access Token (classic with repo scope or fine-grained with read access to contents)
# GITHUB_OWNER: GitHub username or organization (e.g. alsaid66900)
# GITHUB_REPO: Repository name containing the manga JSON files & releases (e.g. nexus-manga-data)
# GITHUB_BRANCH: Target branch (default: main)
GITHUB_TOKEN=placeholder
GITHUB_OWNER=placeholder
GITHUB_REPO=placeholder
GITHUB_BRANCH=main

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=placeholder
